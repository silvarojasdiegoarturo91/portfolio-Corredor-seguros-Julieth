# Optional: SMTP timeout in ms (default: 5000)
# SMTP_CONNECTION_TIMEOUT="5000"
# SMTP_GREETING_TIMEOUT="5000"

# Admin
ADMIN_PASSWORD="cambiar-esta-contrasena"

# WhatsApp
NEXT_PUBLIC_WHATSAPP_NUMBER="34695135678"

# Meta Pixel (Facebook)
NEXT_PUBLIC_META_PIXEL_ID="TU_PIXEL_ID_AQUI"

# Google Search Console verification
# Obtén este valor en: https://search.google.com/search-console/
# Selecciona "Etiqueta HTML" como método de verificación y copia solo el contenido del atributo "content"
