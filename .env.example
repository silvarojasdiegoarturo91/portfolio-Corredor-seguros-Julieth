# Database
DATABASE_URL="postgresql://user:password@localhost:5432/seguros_julieth?schema=public"

# App
NEXT_PUBLIC_BASE_URL="https://juliethperezseguros.com"

# Email (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="tu@email.com"
SMTP_PASS="tu-contrasena-app"
